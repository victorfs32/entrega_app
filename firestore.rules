service cloud.firestore {
  match /databases/{database}/documents {

    match /entregas/{entregaId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /motoristas/{motoristaId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /configuracoes/{documento} {
      allow read, create, update, delete: if request.auth != null;
    }
  }
}
