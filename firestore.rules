rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function motorista() {
      return get(/databases/$(database)/documents/motoristas/$(request.auth.uid)).data;
    }

    function autenticado() {
      return request.auth != null;
    }

    function admin() {
      return autenticado() && motorista().admin == true;
    }

    function ativo() {
      return autenticado() && motorista().ativo == true;
    }

    match /motoristas/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || admin());
      allow write: if admin();
    }

    match /entregas/{id} {
      allow read: if admin() || (ativo() && resource.data.motoristaId == request.auth.uid);
      allow create: if admin() || (ativo() && request.resource.data.motoristaId == request.auth.uid);
      allow update: if admin() || (ativo() && resource.data.motoristaId == request.auth.uid);
      allow delete: if admin();
    }

    match /configuracoes/{doc} {
      allow read, write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
